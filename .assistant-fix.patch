+    def shutdown(self, timeout_ms: int = 12000):
+        """Invalidate pending results and stop worker threads before teardown.
+
+        Normal request replacement remains non-blocking.  Application shutdown is
+        different: a running ``QThread`` must not be destroyed with its worker
+        still active, so we cooperatively cancel every live worker and give the
+        shared network timeout budget a bounded interval to finish.
+        """
         self._req_id += 1
-        for worker in list(self._live_workers):
+        workers = list(self._live_workers)
+        for worker in workers:
             if worker.isRunning():
                 worker.cancel()
+
+        deadline = _time.monotonic() + max(0, timeout_ms) / 1000.0
+        for worker in workers:
+            if not worker.isRunning():
+                continue
+            remaining_ms = max(0, int((deadline - _time.monotonic()) * 1000))
+            if remaining_ms <= 0:
+                break
+            worker.wait(remaining_ms)
+
+        if self._worker is not None and not self._worker.isRunning():
+            self._worker = None
+        self._live_workers = {w for w in self._live_workers if w.isRunning()}
 
