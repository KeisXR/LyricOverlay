{
  "manifest_version": 3,
  "name": "Lyricaod Browser Adapter",
  "version": "1.0.0",
  "description": "Sends media session data to Lyricaod via WebSocket",
  "permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
