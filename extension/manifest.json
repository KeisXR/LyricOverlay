{
  "manifest_version": 3,
  "name": "Lyricaod ブラウザ連携",
  "version": "1.0.0",
  "description": "ブラウザのメディア情報を WebSocket 経由で Lyricaod に送信します",
  "permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
